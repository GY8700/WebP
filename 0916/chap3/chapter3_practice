5번: 다양한 폼 요소를 이용한 도형 서식 입력 폼HTML<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>도형 서식 폼 만들기</title>
</head>
<body>
    <h3>도형 서식 폼 만들기</h3>
    <hr>
    <form>
        <fieldset>
            <legend>도형 서식 입력</legend>
            <p>
                <label>선종류 
                    <select>
                        <option>선없음</option>
                        <option selected>실선</option>
                        <option>점선</option>
                    </select>
                </label>
            </p>
            <p>
                <label>선두께 <input type="number" min="1" value="1"></label>
                <label>선색 <input type="color" value="#0000ff"></label>
            </p>
            <p>
                <label>투명도(0~100) : <input type="range" min="0" max="100" value="50"></label>
            </p>
        </fieldset>
    </form>
</body>
</html>
   
